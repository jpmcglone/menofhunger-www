## Men of Hunger WWW
## Copy to `.env` and adjust as needed.

# Base URL of the API used by the website (HTTP/REST and WebSocket presence).
# This must point to the *versioned* API root (product routes are under /v1).
# Example: http://localhost:3001/v1   or https://api.menofhunger.com/v1 in production
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1
# Server-side override for SSR requests (for example a private network URL). Defaults to the public URL.
# NUXT_API_BASE_URL=

# Public base URL for user-uploaded assets (Cloudflare R2 public bucket / custom domain).
# Example: https://moh-assets.<accountId>.r2.dev
NUXT_PUBLIC_ASSETS_BASE_URL=

# VAPID public key for Web Push. Same value as VAPID_PUBLIC_KEY in menofhunger-api. Required for browser push notifications.
# NUXT_PUBLIC_VAPID_PUBLIC_KEY=

# Facebook App ID for og:fb:app_id. Fixes Sharing Debugger warning and improves link previews in Messenger/Facebook.
# Create an app at developers.facebook.com and set its numeric ID here.
# NUXT_PUBLIC_FACEBOOK_APP_ID=

# iOS App Store numeric ID. Enables the Smart App Banner for iOS Safari visitors once the app is published.
# Find it in App Store Connect (e.g. "id123456789" in the App Store URL — use just the digits).
# NUXT_PUBLIC_IOS_APP_STORE_ID=

# Destination URL for "Get the app" links (footer, settings). Use the App Store URL once live,
# or a TestFlight invite link in the meantime. Leave empty to hide these links entirely.
# NUXT_PUBLIC_IOS_APP_URL=

# Error monitoring. SENTRY_ENVIRONMENT defaults to NODE_ENV; SENTRY_UPLOAD=false skips source map upload.
# NUXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=
# SENTRY_UPLOAD=false

# Product analytics.
# NUXT_PUBLIC_POSTHOG_KEY=
# NUXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google AdSense. ADTEST=true serves test ads.
# NUXT_PUBLIC_ADSENSE_ENABLED=false
# NUXT_PUBLIC_ADSENSE_ADTEST=false
# NUXT_PUBLIC_ADSENSE_CLIENT=
# NUXT_PUBLIC_ADSENSE_RAIL_SLOT=
# NUXT_PUBLIC_ADSENSE_FEED_SLOT=

# Search console ownership meta tags.
# NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NUXT_PUBLIC_BING_SITE_VERIFICATION=

